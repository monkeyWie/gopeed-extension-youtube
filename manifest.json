{
  "name": "youtube",
  "author": "monkeyWie",
  "title": "Youtube",
  "description": "Download YouTube videos, playlists, and Shorts in up to 8K quality when available.",
  "icon": "icon.png",
  "version": "1.4.0",
  "homepage": "https://github.com/monkeyWie/gopeed-extension-youtube",
  "repository": {
    "url": "https://github.com/monkeyWie/gopeed-extension-youtube"
  },
  "scripts": [
    {
      "event": "onResolve",
      "match": {
        "urls": [
          "*://youtube.com/watch/*",
          "*://m.youtube.com/watch/*",
          "*://www.youtube.com/watch/*",
          "*://youtu.be/*",
          "*://youtube.com/shorts/*",
          "*://m.youtube.com/shorts/*",
          "*://www.youtube.com/shorts/*",
          "*://youtube.com/playlist*",
          "*://www.youtube.com/playlist*",
          "*://m.youtube.com/playlist*"
        ]
      },
      "entry": "dist/index.js"
    },
    {
      "event": "onStart",
      "match": {
        "labels": ["monkeyWie@youtube"]
      },
      "entry": "dist/index.js"
    },
    {
      "event": "onError",
      "match": {
        "labels": ["monkeyWie@youtube"]
      },
      "entry": "dist/index.js"
    }
  ],
  "settings": [
    {
      "name": "quality",
      "title": "Quality",
      "description": "Choose your preferred video quality, up to 8K when available.",
      "type": "string",
      "value": "1080p",
      "options": [
        {
          "label": "8K (4320p)",
          "value": "4320p"
        },
        {
          "label": "4k (2160p)",
          "value": "2160p"
        },
        {
          "label": "2k (1440p)",
          "value": "1440p"
        },
        {
          "label": "1080p",
          "value": "1080p"
        },
        {
          "label": "720p",
          "value": "720p"
        },
        {
          "label": "480p",
          "value": "480p"
        },
        {
          "label": "360p",
          "value": "360p"
        },
        {
          "label": "Best",
          "value": "best"
        },
        {
          "label": "Lowest",
          "value": "lowest"
        }
      ]
    },
    {
      "name": "fallbackToBest",
      "title": "Fallback to Best Quality",
      "description": "When the requested resolution does not exist, fall back to the highest available video quality.",
      "type": "boolean",
      "value": true
    },
    {
      "name": "cookie",
      "title": "YouTube Cookie (Optional)",
      "description": "Paste the Cookie request header from YouTube to use your account. Leave empty to download without signing in.",
      "type": "string",
      "value": ""
    }
  ]
}
