{
  "name": "youtube",
  "author": "monkeyWie",
  "title": "Youtube",
  "description": "Youtube video download",
  "icon": "icon.png",
  "version": "1.3.5",
  "homepage": "https://github.com/monkeyWie/gopeed-extension-youtube",
  "repository": {
    "url": "https://github.com/monkeyWie/gopeed-extension-youtube"
  },
  "scripts": [
    {
      "event": "onResolve",
      "match": {
        "urls": [
          "*://youtube.com/watch/*",
          "*://m.youtube.com/watch/*",
          "*://www.youtube.com/watch/*",
          "*://youtu.be/*",
          "*://youtube.com/shorts/*",
          "*://m.youtube.com/shorts/*",
          "*://www.youtube.com/shorts/*"
        ]
      },
      "entry": "dist/index.js"
    }
  ],
  "settings": [
    {
      "name": "quality",
      "title": "Quality",
      "description": "Target video resolution, such as 1080p, 1440p, 2160p, best, or lowest.",
      "type": "string",
      "value": "1080p",
      "options": [
        {
          "label": "4k (2160p)",
          "value": "2160p"
        },
        {
          "label": "2k (1440p)",
          "value": "1440p"
        },
        {
          "label": "1080p",
          "value": "1080p"
        },
        {
          "label": "720p",
          "value": "720p"
        },
        {
          "label": "480p",
          "value": "480p"
        },
        {
          "label": "360p",
          "value": "360p"
        },
        {
          "label": "Best",
          "value": "best"
        },
        {
          "label": "Lowest",
          "value": "lowest"
        }
      ]
    },
    {
      "name": "fallbackToBest",
      "title": "Fallback to Best Quality",
      "description": "When the requested resolution does not exist, fall back to the highest available video quality.",
      "type": "boolean",
      "value": true
    }
  ]
}